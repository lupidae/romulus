  "query": "SELECT s.last_seen_at, u.id, u.email, u.email_verified, u.name,\n                  u.oidc_subject LIKE 'password|%' AS \"password_account!\"\n           FROM sessions s JOIN users u ON u.id = s.user_id\n           WHERE s.id_hash = $1 AND s.expires_at > now()",

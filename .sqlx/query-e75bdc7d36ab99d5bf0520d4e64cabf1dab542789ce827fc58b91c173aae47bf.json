  "query": "SELECT created_at, kind AS \"kind: AuthEventKind\", email, user_id, ip, details\n           FROM auth_events\n           WHERE $1::text IS NULL\n              OR lower(email COLLATE pg_unicode_fast) = lower($1 COLLATE pg_unicode_fast)\n           ORDER BY created_at DESC, id DESC\n           LIMIT $2",

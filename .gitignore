# Rust
/target

# Per-worktree environment (scripts/dev-env) and runtime state (Zitadel credentials…)
/.env
/.dev/

# Web
node_modules/
/web/dist/
/web/dist-perf/
/web/test-results/
/web/playwright-report/
/web/blob-report/
/web/playwright/.cache/
# The live hero's wasm-bindgen output (site/tools/hero.mjs), an input of its build.
/web/.hero/
*.tsbuildinfo

# Homepage
/site/.wrangler/
/site/test-results/
/site/playwright-report/
/site/lighthouse/

# OS / editors
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# The preview's host-only files (deploy/preview/deploy.sh writes them there)
/deploy/preview/.env
/deploy/preview/.host
/deploy/preview/state/

# Python bytecode (the exporter scripts are run in place)
__pycache__/
*.pyc

# A self-hosted install's state (deploy/self-host/install.sh writes it there)
/deploy/self-host/.env
/deploy/self-host/.env.*
/deploy/self-host/backups/

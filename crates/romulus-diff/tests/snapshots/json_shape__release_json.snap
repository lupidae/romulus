      "sql": {
        "before": "CREATE TABLE shop.customers (\n    id bigint GENERATED ALWAYS AS IDENTITY NOT NULL,\n    email shop.email NOT NULL,\n    full_name text NOT NULL,\n    \"select\" text,\n    address shop.address,\n    tags text[] DEFAULT '{}'::text[] NOT NULL,\n    referrer_id bigint,\n    created_at timestamp with time zone DEFAULT now() NOT NULL,\n    CONSTRAINT customers_pkey PRIMARY KEY (id),\n    CONSTRAINT customers_email_key UNIQUE (email)\n);\n\nALTER TABLE shop.customers ADD CONSTRAINT customers_referrer_id_fkey FOREIGN KEY (referrer_id) REFERENCES shop.customers(id) ON DELETE SET NULL;\n\nCOMMENT ON TABLE shop.customers IS 'People who buy things';\nCOMMENT ON COLUMN shop.customers.email IS 'Login identifier; unique per customer';\n",
        "after": "CREATE TABLE shop.customers (\n    id bigint GENERATED ALWAYS AS IDENTITY NOT NULL,\n    email citext NOT NULL,\n    full_name text NOT NULL,\n    \"select\" text,\n    address shop.address,\n    tags text[] DEFAULT '{}'::text[] NOT NULL,\n    referrer_id bigint,\n    created_at timestamp with time zone DEFAULT now() NOT NULL,\n    CONSTRAINT customers_pkey PRIMARY KEY (id),\n    CONSTRAINT customers_email_key UNIQUE (email)\n);\n\nALTER TABLE shop.customers ADD CONSTRAINT customers_referrer_id_fkey FOREIGN KEY (referrer_id) REFERENCES shop.customers(id) ON DELETE SET NULL;\n\nCOMMENT ON TABLE shop.customers IS 'People who buy things';\nCOMMENT ON COLUMN shop.customers.email IS 'Login identifier; unique per customer';\n"

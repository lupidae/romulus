      "sql": {
        "before": "CREATE SEQUENCE IF NOT EXISTS shop.orders_id_seq;\n\nCREATE TABLE shop.orders (\n    id bigint DEFAULT nextval('shop.orders_id_seq'::regclass) NOT NULL,\n    customer_id bigint NOT NULL,\n    status shop.order_status DEFAULT 'draft'::shop.order_status NOT NULL,\n    subtotal shop.money_cents,\n    tax shop.money_cents,\n    total bigint GENERATED ALWAYS AS (((subtotal)::bigint + (tax)::bigint)) STORED,\n    placed_at timestamp with time zone,\n    note text,\n    CONSTRAINT orders_placed_when_not_draft CHECK (((status = 'draft'::shop.order_status) OR (placed_at IS NOT NULL))),\n    CONSTRAINT orders_pkey PRIMARY KEY (id)\n);\nALTER SEQUENCE shop.orders_id_seq OWNED BY shop.orders.id;\n\nALTER TABLE shop.orders ADD CONSTRAINT orders_customer_id_fkey FOREIGN KEY (customer_id) REFERENCES shop.customers(id) ON UPDATE RESTRICT ON DELETE CASCADE;\n\nCREATE INDEX orders_customer_idx ON shop.orders USING btree (customer_id);\nCREATE UNIQUE INDEX orders_note_lower_idx ON shop.orders USING btree (lower(note)) WHERE (note IS NOT NULL);\nCREATE INDEX orders_open_idx ON shop.orders USING btree (placed_at DESC) WHERE (status = ANY (ARRAY['placed'::shop.order_status, 'shipped'::shop.order_status]));\n\nALTER TABLE shop.orders ENABLE ROW LEVEL SECURITY;\nALTER TABLE shop.orders FORCE ROW LEVEL SECURITY;\nCREATE POLICY orders_no_cancelled ON shop.orders AS RESTRICTIVE FOR SELECT TO showcase_reader USING (status <> 'cancelled'::shop.order_status);\nCREATE POLICY orders_owner ON shop.orders FOR ALL USING (customer_id = (current_setting('app.customer_id'::text))::bigint) WITH CHECK (customer_id = (current_setting('app.customer_id'::text))::bigint);\n",
        "after": "CREATE SEQUENCE IF NOT EXISTS shop.orders_id_seq;\n\nCREATE TABLE shop.orders (\n    id bigint DEFAULT nextval('shop.orders_id_seq'::regclass) NOT NULL,\n    customer_id bigint NOT NULL,\n    status shop.order_status DEFAULT 'draft'::shop.order_status NOT NULL,\n    subtotal shop.money_cents,\n    tax shop.money_cents,\n    total bigint GENERATED ALWAYS AS (((subtotal)::bigint + (tax)::bigint)) STORED,\n    placed_at timestamp with time zone,\n    note text NOT NULL,\n    coupon_code text,\n    CONSTRAINT orders_placed_when_not_draft CHECK (((status = 'draft'::shop.order_status) OR (placed_at IS NOT NULL))),\n    CONSTRAINT orders_pkey PRIMARY KEY (id)\n);\nALTER SEQUENCE shop.orders_id_seq OWNED BY shop.orders.id;\n\nALTER TABLE shop.orders ADD CONSTRAINT orders_customer_id_fkey FOREIGN KEY (customer_id) REFERENCES shop.customers(id) ON UPDATE RESTRICT ON DELETE RESTRICT;\n\nCREATE INDEX orders_coupon_idx ON shop.orders USING btree (coupon_code);\nCREATE INDEX orders_customer_idx ON shop.orders USING btree (customer_id);\nCREATE UNIQUE INDEX orders_note_lower_idx ON shop.orders USING btree (lower(note)) WHERE (note IS NOT NULL);\nCREATE INDEX orders_open_idx ON shop.orders USING btree (placed_at DESC) WHERE (status = ANY (ARRAY['placed'::shop.order_status, 'shipped'::shop.order_status]));\n\nALTER TABLE shop.orders ENABLE ROW LEVEL SECURITY;\nALTER TABLE shop.orders FORCE ROW LEVEL SECURITY;\nCREATE POLICY orders_no_cancelled ON shop.orders AS RESTRICTIVE FOR SELECT TO showcase_reader USING (status <> 'cancelled'::shop.order_status);\nCREATE POLICY orders_owner ON shop.orders FOR ALL USING (customer_id = (current_setting('app.customer_id'::text))::bigint) WITH CHECK (customer_id = (current_setting('app.customer_id'::text))::bigint);\n\nCOMMENT ON COLUMN shop.orders.coupon_code IS 'Applied at checkout';\n"
      }

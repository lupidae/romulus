-- Migration of acme/app from v1 to v2, generated by romulus on 2026-10-16.
-- Review it before applying: romulus compares the schemas, not your data.
-- 15 statements, 2 destructive (marked DESTRUCTIVE: they delete data or can
-- fail on existing rows).
--
-- Warnings:
--   - Enum public.mood loses 'ecstatic': it is created again, and converting
--     its columns fails on rows that still hold it.
--   - Domain public.good_mood is created again over public.mood, and its
--     columns converted.

BEGIN;

-- --------------------------------------------------------------------------
-- Dropped first, to change or to make way
-- --------------------------------------------------------------------------

-- Created again below: it changed, or something under it did.
DROP VIEW public.happy_people;

DROP INDEX public.people_happy_idx;

ALTER TABLE public.people DROP CONSTRAINT people_check;

-- --------------------------------------------------------------------------
-- Types
-- --------------------------------------------------------------------------

-- Postgres cannot remove an enum label ('ecstatic'): the type is created
-- again and every column using it converted.
ALTER TYPE public.mood RENAME TO mood_old;

CREATE TYPE public.mood AS ENUM ('sad', 'ok', 'happy');

-- Its type public.mood is created again, so it is too, and every column using
-- it converted.
ALTER DOMAIN public.good_mood RENAME TO good_mood_old;

CREATE DOMAIN public.good_mood AS public.mood CHECK ((VALUE <> 'sad'::public.mood));

-- --------------------------------------------------------------------------
-- Tables and columns
-- --------------------------------------------------------------------------

-- Converts to the recreated domain public.good_mood.
ALTER TABLE public.days ALTER COLUMN overall TYPE public.good_mood USING overall::text::public.good_mood;

-- DESTRUCTIVE: Converts to the recreated enum public.mood: fails on a row
-- holding a label it lost.
ALTER TABLE public.people
    ALTER COLUMN mood DROP DEFAULT,
    ALTER COLUMN mood TYPE public.mood USING mood::text::public.mood,
    ALTER COLUMN mood SET DEFAULT 'ok'::public.mood;

-- DESTRUCTIVE: Converts to the recreated enum public.mood: fails on a row
-- holding a label it lost.
ALTER TABLE public.people
    ALTER COLUMN history DROP DEFAULT,
    ALTER COLUMN history TYPE public.mood[] USING history::text[]::public.mood[],
    ALTER COLUMN history SET DEFAULT ARRAY['ok'::public.mood];

-- --------------------------------------------------------------------------
-- Constraints and indexes
-- --------------------------------------------------------------------------

-- Dropped above and built again: it names public.mood, which is created
-- again.
ALTER TABLE public.people ADD CONSTRAINT people_check CHECK (((mood <> 'sad'::public.mood) OR (id > 0)));

CREATE INDEX people_happy_idx ON public.people USING btree (id) WHERE (mood = 'happy'::public.mood);

-- --------------------------------------------------------------------------
-- Views
-- --------------------------------------------------------------------------

CREATE VIEW public.happy_people AS
SELECT id,
    mood
   FROM public.people
  WHERE mood = 'happy'::public.mood;

-- --------------------------------------------------------------------------
-- Removals
-- --------------------------------------------------------------------------

DROP DOMAIN public.good_mood_old;

DROP TYPE public.mood_old;

COMMIT;

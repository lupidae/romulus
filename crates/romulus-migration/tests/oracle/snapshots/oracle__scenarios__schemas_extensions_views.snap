-- Migration of acme/app from v1 to v2, generated by romulus on 2026-10-16.
-- Review it before applying: romulus compares the schemas, not your data.
-- 16 statements, none flagged.
--
-- Warnings:
--   - Functions and triggers are not in romulus's model, and Postgres does
--     not rewrite their bodies: check any that use public.base.name (now
--     text).

BEGIN;

-- --------------------------------------------------------------------------
-- Schemas and extensions
-- --------------------------------------------------------------------------

CREATE SCHEMA IF NOT EXISTS reporting;

CREATE EXTENSION IF NOT EXISTS pgcrypto WITH SCHEMA public;

-- --------------------------------------------------------------------------
-- Dropped first, to change or to make way
-- --------------------------------------------------------------------------

-- Created again below: it changed, or something under it did.
DROP VIEW public.level3;

-- Created again below: it changed, or something under it did.
DROP VIEW public.level2;

DROP VIEW public.doomed_too;

-- Created again below: it changed, or something under it did.
DROP VIEW public.level1;

DROP VIEW public.doomed;

-- --------------------------------------------------------------------------
-- Tables and columns
-- --------------------------------------------------------------------------

CREATE TABLE reporting.runs (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    base_id integer,
    CONSTRAINT runs_pkey PRIMARY KEY (id)
);

ALTER TABLE public.base ALTER COLUMN name TYPE text;

-- Rewrites the whole table, locking it meanwhile.
ALTER TABLE public.cache SET LOGGED;

-- --------------------------------------------------------------------------
-- Constraints and indexes
-- --------------------------------------------------------------------------

ALTER TABLE reporting.runs ADD CONSTRAINT runs_base_id_fkey FOREIGN KEY (base_id) REFERENCES public.base(id);

-- --------------------------------------------------------------------------
-- Views
-- --------------------------------------------------------------------------

CREATE VIEW public.level1 AS
SELECT id,
    name,
    n,
    n * 2 AS twice
   FROM public.base;

CREATE VIEW public.level2 AS
SELECT id,
    name
   FROM public.level1
  WHERE n > 0;

CREATE VIEW reporting.latest AS
SELECT r.id,
    b.name
   FROM reporting.runs r
     JOIN public.level1 b ON b.id = r.base_id;

CREATE VIEW public.level3 AS
SELECT id
   FROM public.level2;

-- --------------------------------------------------------------------------
-- Removals
-- --------------------------------------------------------------------------

-- Fails while something still uses it.
DROP EXTENSION citext;

COMMIT;

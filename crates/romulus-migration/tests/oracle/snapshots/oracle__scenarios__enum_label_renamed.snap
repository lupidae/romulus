-- Migration of acme/app from v1 to v2, generated by romulus on 2026-10-16.
-- Review it before applying: romulus compares the schemas, not your data.
-- 4 statements: 1 can fail on existing rows (CAN FAIL), each marked.
--
-- Warnings:
--   - Enum public.size loses 'medium': it is created again, and converting
--     its columns fails on rows that still hold it.

BEGIN;

-- --------------------------------------------------------------------------
-- Types
-- --------------------------------------------------------------------------

-- Postgres cannot remove an enum label ('medium'): the type is created again
-- and every column using it converted. If 'medium' was renamed to 'regular',
-- the RENAME VALUE below does it in place instead.
-- To keep the data instead:
--   ALTER TYPE public.size RENAME VALUE 'medium' TO 'regular';
ALTER TYPE public.size RENAME TO size_old;

CREATE TYPE public.size AS ENUM ('small', 'regular', 'large');

-- --------------------------------------------------------------------------
-- Tables and columns
-- --------------------------------------------------------------------------

-- CAN FAIL: Converts to the recreated enum public.size: fails on a row
-- holding a label it lost.
ALTER TABLE public.shirts ALTER COLUMN size TYPE public.size USING size::text::public.size;

-- --------------------------------------------------------------------------
-- Removals
-- --------------------------------------------------------------------------

DROP TYPE public.size_old;

COMMIT;

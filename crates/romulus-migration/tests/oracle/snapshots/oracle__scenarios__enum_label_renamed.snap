-- Review it before applying: romulus compares the schemas, not your data.
-- 1 statement, none flagged.
--
-- Warnings:
--   - Functions and triggers are not in romulus's model, and Postgres does
--     not rewrite their bodies: check any that use public.size.medium →
--     regular (renamed).

BEGIN;

-- --------------------------------------------------------------------------
-- Renames
-- --------------------------------------------------------------------------

-- Detected as a rename (same place among the labels): turn it off to drop and
-- add instead. Rows holding the label read the new one.
ALTER TYPE public.size RENAME VALUE 'medium' TO 'regular';

COMMIT;

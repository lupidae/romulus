-- Migration of acme/app from v1 to v2, generated by romulus on 2026-10-16.
-- Review it before applying: romulus compares the schemas, not your data.
-- 4 statements: 1 can fail on existing rows (CAN FAIL), each marked.
--
-- Warnings:
--   - Enum public.mood loses 'sad': it is created again, and converting its
--     columns fails on rows that still hold it.
--   - Functions and triggers are not in romulus's model, and Postgres does
--     not rewrite their bodies: check any that use public.days.mood (now
--     public.mood).

BEGIN;

-- --------------------------------------------------------------------------
-- Types
-- --------------------------------------------------------------------------

-- Postgres cannot remove an enum label ('sad'): the type is created again and
-- every column using it converted.
ALTER TYPE public.mood RENAME TO mood_old;

CREATE TYPE public.mood AS ENUM ('ok');

-- --------------------------------------------------------------------------
-- Tables and columns
-- --------------------------------------------------------------------------

-- CAN FAIL: Converts to the recreated enum public.mood: fails on a row
-- holding a label it lost.
ALTER TABLE public.days
    ALTER COLUMN mood DROP DEFAULT,
    ALTER COLUMN mood TYPE public.mood USING mood::text::public.mood,
    ALTER COLUMN mood SET DEFAULT 'ok'::public.mood;

-- --------------------------------------------------------------------------
-- Removals
-- --------------------------------------------------------------------------

DROP TYPE public.mood_old;

COMMIT;

-- Migration of acme/app from v1 to v2, generated by romulus on 2026-10-16.
-- Review it before applying: romulus compares the schemas, not your data.
-- 8 statements: 1 can fail on existing rows (CAN FAIL), each marked.
--
-- Warnings:
--   - Domain public.money_cents is created again over bigint, and its columns
--     converted.
--   - Functions and triggers are not in romulus's model, and Postgres does
--     not rewrite their bodies: check any that use public.lines.amount (now
--     public.money_cents).

BEGIN;

-- --------------------------------------------------------------------------
-- Dropped first, to change or to make way
-- --------------------------------------------------------------------------

-- Created again below: it changed, or something under it did.
DROP VIEW public.big_lines;

ALTER TABLE public.lines DROP CONSTRAINT small;

-- --------------------------------------------------------------------------
-- Types
-- --------------------------------------------------------------------------

-- Postgres cannot change a domain's type (integer → bigint): it is created
-- again and every column using it converted.
ALTER DOMAIN public.money_cents RENAME TO money_cents_old;

CREATE DOMAIN public.money_cents AS bigint CHECK ((VALUE >= 0));

-- --------------------------------------------------------------------------
-- Tables and columns
-- --------------------------------------------------------------------------

-- Converts to the recreated domain public.money_cents.
ALTER TABLE public.lines ALTER COLUMN amount TYPE public.money_cents;

-- --------------------------------------------------------------------------
-- Constraints and indexes
-- --------------------------------------------------------------------------

-- CAN FAIL: Fails if an existing row breaks it. On a large table, add it NOT
-- VALID, then VALIDATE CONSTRAINT.
ALTER TABLE public.lines ADD CONSTRAINT small CHECK (((amount)::bigint < 1000000));

-- --------------------------------------------------------------------------
-- Views
-- --------------------------------------------------------------------------

CREATE VIEW public.big_lines AS
SELECT id,
    amount
   FROM public.lines
  WHERE amount::bigint > 1000;

-- --------------------------------------------------------------------------
-- Removals
-- --------------------------------------------------------------------------

DROP DOMAIN public.money_cents_old;

COMMIT;

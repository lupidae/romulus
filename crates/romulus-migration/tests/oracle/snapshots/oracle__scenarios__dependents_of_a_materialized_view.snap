-- Migration of acme/app from v1 to v2, generated by romulus on 2026-10-16.
-- Review it before applying: romulus compares the schemas, not your data.
-- 5 statements, none flagged.
--
-- Warnings:
--   - Functions and triggers are not in romulus's model, and Postgres does
--     not rewrite their bodies: check any that use public.readings.value (now
--     numeric).

BEGIN;

-- --------------------------------------------------------------------------
-- Dropped first, to change or to make way
-- --------------------------------------------------------------------------

-- Created again below: it changed, or something under it did.
DROP MATERIALIZED VIEW public.reading_stats;

-- --------------------------------------------------------------------------
-- Tables and columns
-- --------------------------------------------------------------------------

ALTER TABLE public.readings ALTER COLUMN value TYPE numeric;

-- --------------------------------------------------------------------------
-- Views
-- --------------------------------------------------------------------------

-- Runs its query to fill it. On large tables, add WITH NO DATA and REFRESH it
-- later.
CREATE MATERIALIZED VIEW public.reading_stats AS
SELECT count(*) AS n,
    max(value) AS top
   FROM public.readings;

CREATE UNIQUE INDEX reading_stats_n ON public.reading_stats USING btree (n);

-- --------------------------------------------------------------------------
-- Comments
-- --------------------------------------------------------------------------

COMMENT ON MATERIALIZED VIEW public.reading_stats IS 'Refreshed nightly';

COMMIT;

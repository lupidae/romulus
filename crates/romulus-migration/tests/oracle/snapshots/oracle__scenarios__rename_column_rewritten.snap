-- Migration of acme/app from v1 to v2, generated by romulus on 2026-10-16.
-- Review it before applying: romulus compares the schemas, not your data.
-- 7 statements, none flagged.
--
-- Warnings:
--   - Functions and triggers are not in romulus's model, and Postgres does
--     not rewrite their bodies: check any that use public.users.email →
--     email_address (renamed).

BEGIN;

-- --------------------------------------------------------------------------
-- Renames
-- --------------------------------------------------------------------------

-- Detected as a rename (same type, nullability, default and keys; same place;
-- similar name): turn it off to drop and add instead. Keeps the column and
-- its data.
ALTER TABLE public.users RENAME COLUMN email TO email_address;

-- With the rename of public.users.email → email_address: Postgres keeps the
-- old name, which the new schema does not.
ALTER TABLE public.users RENAME CONSTRAINT users_email_check TO users_email_address_check;

-- With the rename of public.users.email → email_address: Postgres keeps the
-- old name, which the new schema does not.
ALTER TABLE public.users RENAME CONSTRAINT users_email_key TO users_email_address_key;

-- --------------------------------------------------------------------------
-- Dropped first, to change or to make way
-- --------------------------------------------------------------------------

-- Created again below: it changed, or something under it did.
DROP VIEW public.user_emails;

-- Created again below: it changed, or something under it did.
DROP VIEW public.invite_senders;

-- --------------------------------------------------------------------------
-- Views
-- --------------------------------------------------------------------------

CREATE VIEW public.invite_senders AS
SELECT i.id,
    u.email_address
   FROM public.invites i
     JOIN public.users u ON u.email_address = i.sender_email;

CREATE VIEW public.user_emails AS
SELECT id,
    email_address
   FROM public.users;

COMMIT;

source: crates/romulus-migration/tests/oracle/scenarios.rs
expression: "plain[0].content"
---
-- Migration of acme/app from v1 to v2, generated by romulus on 2026-10-16.
-- Review it before applying: romulus compares the schemas, not your data.
-- 17 statements, 3 destructive (marked DESTRUCTIVE: they delete data or can
-- fail on existing rows).
--
-- Warnings:
--   - Enum public.color loses 'blue': it is created again, and converting its
--     columns fails on rows that still hold it.
--   - Domain public.cents is created again over bigint, and its columns
--     converted.
--   - Domain public.warm is created again over public.color, and its columns
--     converted.

BEGIN;

-- --------------------------------------------------------------------------
-- Types
-- --------------------------------------------------------------------------

-- Postgres cannot remove an enum label ('blue'): the type is created again
-- and every column using it converted.
ALTER TYPE public.color RENAME TO color_old;

CREATE TYPE public.color AS ENUM ('red', 'green');

-- Postgres cannot change a domain's type (integer → bigint): it is created
-- again and every column using it converted.
ALTER DOMAIN public.cents RENAME TO cents_old;

CREATE DOMAIN public.cents AS bigint DEFAULT 0 CHECK ((VALUE >= 0));

ALTER DOMAIN public.code SET DEFAULT 'none'::character varying;

-- DESTRUCTIVE: Fails if a column of this domain holds a NULL.
ALTER DOMAIN public.code SET NOT NULL;

-- Fails if a value of this domain already breaks it.
ALTER DOMAIN public.email ADD CHECK ((length(VALUE) < 255));

-- Its type public.color is created again, so it is too, and every column
-- using it converted.
ALTER DOMAIN public.warm RENAME TO warm_old;

CREATE DOMAIN public.warm AS public.color CHECK ((VALUE <> 'green'::public.color));

-- DESTRUCTIVE: Deletes this attribute from every value of the type.
ALTER TYPE public.address DROP ATTRIBUTE zip;

-- DESTRUCTIVE: Converts text to character varying(80): values that do not
-- convert are lost.
ALTER TYPE public.address ALTER ATTRIBUTE city TYPE character varying(80);

ALTER TYPE public.address ADD ATTRIBUTE country text;

-- --------------------------------------------------------------------------
-- Tables and columns
-- --------------------------------------------------------------------------

-- Converts to the recreated domain public.cents.
ALTER TABLE public.contacts ALTER COLUMN balance TYPE public.cents;

-- Converts to the recreated domain public.warm.
ALTER TABLE public.contacts ALTER COLUMN tint TYPE public.warm USING tint::text::public.warm;

-- --------------------------------------------------------------------------
-- Removals
-- --------------------------------------------------------------------------

DROP DOMAIN public.cents_old;

DROP DOMAIN public.warm_old;

DROP TYPE public.color_old;

COMMIT;

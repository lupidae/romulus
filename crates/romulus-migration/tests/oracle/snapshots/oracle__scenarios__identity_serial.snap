-- Migration of acme/app from v1 to v2, generated by romulus on 2026-10-16.
-- Review it before applying: romulus compares the schemas, not your data.
-- 14 statements: 1 can fail on existing rows (CAN FAIL), each marked.

BEGIN;

-- --------------------------------------------------------------------------
-- Tables and columns
-- --------------------------------------------------------------------------

-- Drops the identity's sequence too.
ALTER TABLE public.a ALTER COLUMN id DROP IDENTITY;

CREATE SEQUENCE IF NOT EXISTS public.a_id_seq;

ALTER TABLE public.a ALTER COLUMN id SET DEFAULT nextval('public.a_id_seq'::regclass);

-- Moves the new sequence past the values the column already holds.
SELECT setval('public.a_id_seq', coalesce(max(id), 0) + 1, false) FROM public.a;

ALTER SEQUENCE public.a_id_seq OWNED BY public.a.id;

ALTER TABLE public.b ALTER COLUMN id DROP DEFAULT;

-- The serial sequence goes: the identity below makes its own, under the same
-- name.
DROP SEQUENCE public.b_id_seq;

ALTER TABLE public.b ALTER COLUMN id ADD GENERATED ALWAYS AS IDENTITY;

-- The identity's sequence starts at 1: moved past the values the column
-- already holds.
SELECT setval(pg_get_serial_sequence('public.b', 'id'), coalesce(max(id), 0) + 1, false) FROM public.b;

CREATE SEQUENCE IF NOT EXISTS public.c_code_seq;

ALTER TABLE public.c ALTER COLUMN code SET DEFAULT nextval('public.c_code_seq'::regclass);

-- Moves the new sequence past the values the column already holds.
SELECT setval('public.c_code_seq', coalesce(max(code), 0) + 1, false) FROM public.c;

ALTER SEQUENCE public.c_code_seq OWNED BY public.c.code;

-- CAN FAIL: Fails if a row holds NULL here: fill those first.
ALTER TABLE public.c ALTER COLUMN code SET NOT NULL;

COMMIT;

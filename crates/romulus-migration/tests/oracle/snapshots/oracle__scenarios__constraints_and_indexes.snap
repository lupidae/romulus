-- Migration of acme/app from v1 to v2, generated by romulus on 2026-10-16.
-- Review it before applying: romulus compares the schemas, not your data.
-- 16 statements, none destructive.

BEGIN;

-- --------------------------------------------------------------------------
-- Dropped first, to change or to make way
-- --------------------------------------------------------------------------

ALTER TABLE public.children DROP CONSTRAINT children_code_fkey;

ALTER TABLE public.children DROP CONSTRAINT children_parent_id_fkey;

DROP INDEX public.children_amount_idx;

DROP INDEX public.children_parent_idx;

DROP INDEX public.parents_code_key;

ALTER TABLE public.children DROP CONSTRAINT children_amount_check;

ALTER TABLE public.parents DROP CONSTRAINT parents_pkey;

-- --------------------------------------------------------------------------
-- Constraints and indexes
-- --------------------------------------------------------------------------

-- Fails if an existing row breaks it. On a large table, add it NOT VALID,
-- then VALIDATE CONSTRAINT.
ALTER TABLE public.children ADD CONSTRAINT children_amount_check CHECK ((amount >= 0));

-- Fails if existing rows conflict; builds an index, blocking writes
-- meanwhile.
ALTER TABLE public.children ADD CONSTRAINT children_no_overlap EXCLUDE USING gist (room WITH =, during WITH &&);

-- Fails if existing rows hold duplicates; builds an index, blocking writes
-- meanwhile.
ALTER TABLE public.parents ADD CONSTRAINT parents_code_key UNIQUE (code);

-- Fails if existing rows hold duplicates; builds an index, blocking writes
-- meanwhile.
ALTER TABLE public.parents ADD CONSTRAINT parents_id_key UNIQUE (id);

-- Fails if existing rows hold duplicates or NULLs; builds an index, blocking
-- writes meanwhile.
ALTER TABLE public.parents ADD CONSTRAINT parents_pkey PRIMARY KEY (id, code);

CREATE INDEX children_amount_idx ON public.children USING btree (amount) WHERE (amount > 10);

CREATE INDEX children_code_idx ON public.children USING btree (parent_code);

-- Dropped above and added back: the key it references on public.parents is
-- rebuilt.
ALTER TABLE public.children ADD CONSTRAINT children_code_fkey FOREIGN KEY (parent_code) REFERENCES public.parents(code);

-- Fails if an existing row points nowhere. On a large table, add it NOT
-- VALID, then VALIDATE CONSTRAINT.
ALTER TABLE public.children ADD CONSTRAINT children_parent_id_fkey FOREIGN KEY (parent_id) REFERENCES public.parents(id) ON DELETE CASCADE DEFERRABLE;

COMMIT;

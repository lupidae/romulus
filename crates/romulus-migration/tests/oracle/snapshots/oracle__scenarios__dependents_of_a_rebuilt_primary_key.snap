-- Migration of acme/app from v1 to v2, generated by romulus on 2026-10-16.
-- Review it before applying: romulus compares the schemas, not your data.
-- 8 statements: 2 can fail on existing rows (CAN FAIL), each marked.

BEGIN;

-- --------------------------------------------------------------------------
-- Dropped first, to change or to make way
-- --------------------------------------------------------------------------

ALTER TABLE billing.invoices DROP CONSTRAINT invoices_customer_id_fkey;

ALTER TABLE public.orders DROP CONSTRAINT orders_customer_fkey;

ALTER TABLE public.customers DROP CONSTRAINT customers_pkey;

-- --------------------------------------------------------------------------
-- Constraints and indexes
-- --------------------------------------------------------------------------

-- CAN FAIL: Fails if existing rows hold duplicates; builds an index, blocking
-- writes meanwhile.
ALTER TABLE public.customers ADD CONSTRAINT customers_id_key UNIQUE (id);

-- CAN FAIL: Fails if existing rows hold duplicates or NULLs; builds an index,
-- blocking writes meanwhile.
ALTER TABLE public.customers ADD CONSTRAINT customers_pkey PRIMARY KEY (id, region);

-- Dropped above and added back: the key it references on public.customers is
-- rebuilt.
ALTER TABLE billing.invoices ADD CONSTRAINT invoices_customer_id_fkey FOREIGN KEY (customer_id) REFERENCES public.customers(id);

-- Dropped above and added back: the key it references on public.customers is
-- rebuilt.
ALTER TABLE public.orders ADD CONSTRAINT orders_customer_fkey FOREIGN KEY (customer_id) REFERENCES public.customers(id) ON DELETE CASCADE;

-- --------------------------------------------------------------------------
-- Comments
-- --------------------------------------------------------------------------

COMMENT ON CONSTRAINT orders_customer_fkey ON public.orders IS 'Who ordered';

COMMIT;

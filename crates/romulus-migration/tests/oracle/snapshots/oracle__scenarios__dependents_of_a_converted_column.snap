-- Migration of acme/app from v1 to v2, generated by romulus on 2026-10-16.
-- Review it before applying: romulus compares the schemas, not your data.
-- 15 statements: 1 widens access (WIDENS ACCESS), each marked.
--
-- Warnings:
--   - public.accounts: policy own_code changed. Check who can now read or
--     change which rows.
--   - Functions and triggers are not in romulus's model, and Postgres does
--     not rewrite their bodies: check any that use public.accounts.code (now
--     text), public.accounts.score (now bigint), public.payments.account_code
--     (now text).

BEGIN;

-- --------------------------------------------------------------------------
-- Dropped first, to change or to make way
-- --------------------------------------------------------------------------

DROP POLICY own_code ON public.accounts;

-- Created again below: it changed, or something under it did.
DROP VIEW public.top_codes;

-- Created again below: it changed, or something under it did.
DROP VIEW public.account_codes;

ALTER TABLE public.payments DROP CONSTRAINT payments_account_code_fkey;

DROP INDEX public.accounts_code_lower;

-- --------------------------------------------------------------------------
-- Tables and columns
-- --------------------------------------------------------------------------

-- Postgres cannot convert a column a generated column reads: dropped before
-- code changes type, and added again after.
ALTER TABLE public.accounts DROP COLUMN label;

ALTER TABLE public.accounts ALTER COLUMN code TYPE text;

ALTER TABLE public.accounts
    ALTER COLUMN score DROP DEFAULT,
    ALTER COLUMN score TYPE bigint,
    ALTER COLUMN score SET DEFAULT 0;

ALTER TABLE public.payments ALTER COLUMN account_code TYPE text;

ALTER TABLE public.accounts ADD COLUMN label text GENERATED ALWAYS AS ((code || '!'::text)) STORED;

-- --------------------------------------------------------------------------
-- Constraints and indexes
-- --------------------------------------------------------------------------

CREATE INDEX accounts_code_lower ON public.accounts USING btree (lower(code));

-- Dropped above and added back: a column it joins changes type.
ALTER TABLE public.payments ADD CONSTRAINT payments_account_code_fkey FOREIGN KEY (account_code) REFERENCES public.accounts(code);

-- --------------------------------------------------------------------------
-- Views
-- --------------------------------------------------------------------------

CREATE VIEW public.account_codes AS
SELECT id,
    code,
    score
   FROM public.accounts;

CREATE VIEW public.top_codes AS
SELECT code
   FROM public.account_codes
  WHERE score > 100;

-- --------------------------------------------------------------------------
-- Row level security
-- --------------------------------------------------------------------------

-- WIDENS ACCESS: Changed: check its roles and expressions do not let more
-- through.
CREATE POLICY own_code ON public.accounts FOR ALL USING (code <> 'hidden'::text);

COMMIT;

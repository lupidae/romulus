-- Migration of acme/app from v1 to v2, generated by romulus on 2026-10-16.
-- Review it before applying: romulus compares the schemas, not your data.
-- 15 statements: 4 can fail on existing rows (CAN FAIL), each marked.
--
-- Warnings:
--   - items.ref goes from uuid to bigint through text: the conversion fails
--     unless every value reads as bigint.

BEGIN;

-- --------------------------------------------------------------------------
-- Dropped first, to change or to make way
-- --------------------------------------------------------------------------

DROP POLICY items_mine ON public.items;

-- Created again below: it changed, or something under it did.
DROP VIEW public.cheap_items;

ALTER TABLE public.items DROP CONSTRAINT items_account_id_fkey;

-- --------------------------------------------------------------------------
-- Tables and columns
-- --------------------------------------------------------------------------

ALTER TABLE public.accounts ALTER COLUMN id TYPE bigint;

ALTER TABLE public.accounts ALTER COLUMN code TYPE character varying(20);

ALTER TABLE public.items ALTER COLUMN account_id TYPE bigint;

-- CAN FAIL: Converts text to numeric(10,2): fails on a value that does not
-- convert.
ALTER TABLE public.items
    ALTER COLUMN price DROP DEFAULT,
    ALTER COLUMN price TYPE numeric(10,2) USING price::numeric(10,2),
    ALTER COLUMN price SET DEFAULT 0;

-- CAN FAIL: Converts bigint to integer: fails on a value that does not
-- convert.
ALTER TABLE public.items
    ALTER COLUMN qty DROP DEFAULT,
    ALTER COLUMN qty TYPE integer USING qty::integer,
    ALTER COLUMN qty SET DEFAULT 1;

-- CAN FAIL: No cast from uuid to bigint: converted through text, which fails
-- unless every value reads as bigint.
ALTER TABLE public.items ALTER COLUMN ref TYPE bigint USING ref::text::bigint;

ALTER TABLE public.items ALTER COLUMN label TYPE text;

-- Reads the existing values in the session's TimeZone: set it to the one they
-- were written in.
ALTER TABLE public.items ALTER COLUMN seen TYPE timestamp with time zone;

-- CAN FAIL: Converts integer to boolean: fails on a value that does not
-- convert.
ALTER TABLE public.items
    ALTER COLUMN flags DROP DEFAULT,
    ALTER COLUMN flags TYPE boolean USING flags::boolean,
    ALTER COLUMN flags SET DEFAULT false;

-- --------------------------------------------------------------------------
-- Constraints and indexes
-- --------------------------------------------------------------------------

-- Dropped above and added back: a column it joins changes type.
ALTER TABLE public.items ADD CONSTRAINT items_account_id_fkey FOREIGN KEY (account_id) REFERENCES public.accounts(id);

-- --------------------------------------------------------------------------
-- Views
-- --------------------------------------------------------------------------

CREATE VIEW public.cheap_items AS
SELECT id,
    price,
    qty
   FROM public.items;

-- --------------------------------------------------------------------------
-- Row level security
-- --------------------------------------------------------------------------

-- Dropped above and created again around a change it names.
CREATE POLICY items_mine ON public.items FOR ALL USING (qty > 0);

COMMIT;

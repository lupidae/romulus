-- Migration of acme/app from v1 to v2, generated by romulus on 2026-10-16.
-- Review it before applying: romulus compares the schemas, not your data.
-- 5 statements, none destructive.

-- Committed before the transaction: the migration uses these enum values, and
-- Postgres refuses a value added in the same transaction.
-- Committed before the rest: Postgres refuses a value added in the same
-- transaction ("unsafe use of new value"), and the migration uses it.
ALTER TYPE public.ticket_state ADD VALUE 'draft' BEFORE 'open';

-- Committed before the rest: Postgres refuses a value added in the same
-- transaction ("unsafe use of new value"), and the migration uses it.
ALTER TYPE public.ticket_state ADD VALUE 'pending' AFTER 'open';

-- Committed before the rest: Postgres refuses a value added in the same
-- transaction ("unsafe use of new value"), and the migration uses it.
ALTER TYPE public.ticket_state ADD VALUE 'review' AFTER 'pending';

-- Committed before the rest: Postgres refuses a value added in the same
-- transaction ("unsafe use of new value"), and the migration uses it.
ALTER TYPE public.ticket_state ADD VALUE 'archived';

BEGIN;

-- --------------------------------------------------------------------------
-- Tables and columns
-- --------------------------------------------------------------------------

ALTER TABLE public.tickets ALTER COLUMN state SET DEFAULT 'pending'::public.ticket_state;

COMMIT;

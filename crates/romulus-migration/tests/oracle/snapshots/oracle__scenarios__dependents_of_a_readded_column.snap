-- Migration of acme/app from v1 to v2, generated by romulus on 2026-10-16.
-- Review it before applying: romulus compares the schemas, not your data.
-- 13 statements: 1 deletes data (DESTRUCTIVE), each marked.

BEGIN;

-- --------------------------------------------------------------------------
-- Dropped first, to change or to make way
-- --------------------------------------------------------------------------

DROP POLICY visible ON public.products;

-- Created again below: it changed, or something under it did.
DROP VIEW public.skus;

ALTER TABLE public.stock DROP CONSTRAINT stock_sku_fkey;

DROP INDEX public.products_sku_lower;

ALTER TABLE public.products DROP CONSTRAINT products_sku_key;

-- --------------------------------------------------------------------------
-- Tables and columns
-- --------------------------------------------------------------------------

-- DESTRUCTIVE: It becomes generated, which Postgres cannot do in place:
-- dropped and added again, its values replaced by the generated ones.
ALTER TABLE public.products DROP COLUMN sku;

ALTER TABLE public.products ADD COLUMN sku text GENERATED ALWAYS AS (('P'::text || (id)::text)) STORED;

-- --------------------------------------------------------------------------
-- Constraints and indexes
-- --------------------------------------------------------------------------

-- Dropped above and built again on sku, which is added again.
ALTER TABLE public.products ADD CONSTRAINT products_sku_key UNIQUE (sku);

-- Dropped above and built again on sku, which is added again.
CREATE INDEX products_sku_lower ON public.products USING btree (lower(sku));

-- Dropped above and added back: the key it references on public.products is
-- rebuilt.
ALTER TABLE public.stock ADD CONSTRAINT stock_sku_fkey FOREIGN KEY (sku) REFERENCES public.products(sku);

-- --------------------------------------------------------------------------
-- Views
-- --------------------------------------------------------------------------

CREATE VIEW public.skus AS
SELECT id,
    sku
   FROM public.products;

-- --------------------------------------------------------------------------
-- Row level security
-- --------------------------------------------------------------------------

-- Dropped above and created again around a change it names.
CREATE POLICY visible ON public.products FOR ALL USING (sku IS NOT NULL);

-- --------------------------------------------------------------------------
-- Comments
-- --------------------------------------------------------------------------

COMMENT ON COLUMN public.products.sku IS 'Stock keeping unit';

COMMIT;

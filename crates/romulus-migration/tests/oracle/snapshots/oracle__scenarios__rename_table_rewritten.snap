-- Migration of acme/app from v1 to v2, generated by romulus on 2026-10-16.
-- Review it before applying: romulus compares the schemas, not your data.
-- 4 statements, none flagged.
--
-- Warnings:
--   - Functions and triggers are not in romulus's model, and Postgres does
--     not rewrite their bodies: check any that use public.customers → clients
--     (renamed), public.clients.customers_id_seq → clients_id_seq (renamed).

BEGIN;

-- --------------------------------------------------------------------------
-- Renames
-- --------------------------------------------------------------------------

-- Detected as a rename (same columns, keys and indexes; its foreign keys
-- follow it): turn it off to drop and add instead. Keeps the table, its rows,
-- and everything on it or referencing it.
ALTER TABLE public.customers RENAME TO clients;

-- With the rename of public.customers → clients: Postgres keeps the old name,
-- which the new schema does not.
ALTER SEQUENCE public.customers_id_seq RENAME TO clients_id_seq;

-- With the rename of public.customers → clients: Postgres keeps the old name,
-- which the new schema does not.
ALTER TABLE public.clients RENAME CONSTRAINT customers_pkey TO clients_pkey;

-- With the rename of public.customers → clients: Postgres keeps the old name,
-- which the new schema does not.
ALTER INDEX public.customers_email_idx RENAME TO clients_email_idx;

COMMIT;

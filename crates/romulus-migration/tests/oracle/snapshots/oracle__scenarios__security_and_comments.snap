source: crates/romulus-migration/tests/oracle/scenarios.rs
expression: "plain[0].content"
---
-- Migration of acme/app from v1 to v2, generated by romulus on 2026-10-16.
-- Review it before applying: romulus compares the schemas, not your data.
-- 15 statements, none destructive.

BEGIN;

-- --------------------------------------------------------------------------
-- Dropped first, to change or to make way
-- --------------------------------------------------------------------------

DROP POLICY docs_kind ON public.docs;

DROP POLICY docs_old ON public.docs;

-- --------------------------------------------------------------------------
-- Row level security
-- --------------------------------------------------------------------------

ALTER TABLE public.docs FORCE ROW LEVEL SECURITY;

CREATE POLICY docs_kind ON public.docs AS RESTRICTIVE FOR ALL USING (true);

CREATE POLICY docs_new ON public.docs FOR INSERT WITH CHECK (true);

ALTER POLICY docs_read ON public.docs TO app_admin, app_user USING ((owner = CURRENT_USER) OR (level = 'low'::public.level));

ALTER POLICY docs_write ON public.docs USING (owner = CURRENT_USER) WITH CHECK (owner = CURRENT_USER);

ALTER TABLE public.secrets DISABLE ROW LEVEL SECURITY;

-- --------------------------------------------------------------------------
-- Comments
-- --------------------------------------------------------------------------

COMMENT ON TYPE public.level IS NULL;

COMMENT ON DOMAIN public.positive IS 'Above zero';

COMMENT ON CONSTRAINT docs_size_check ON public.docs IS 'Keep them small';

COMMENT ON TABLE public.docs IS 'Documents, versioned';

COMMENT ON COLUMN public.docs.id IS 'Stable';

COMMENT ON COLUMN public.docs.owner IS NULL;

COMMENT ON TABLE public.secrets IS 'No policies';

COMMIT;

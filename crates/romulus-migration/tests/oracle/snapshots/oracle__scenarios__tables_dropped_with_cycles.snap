-- Migration of acme/app from v1 to v2, generated by romulus on 2026-10-16.
-- Review it before applying: romulus compares the schemas, not your data.
-- 9 statements, 4 destructive (marked DESTRUCTIVE: they delete data or can
-- fail on existing rows).
--
-- Warnings:
--   - Table public.customers is dropped and public.clients created with the
--     same columns: if it is a rename, use ALTER TABLE … RENAME TO (in the
--     comment) to keep the rows.

BEGIN;

-- --------------------------------------------------------------------------
-- Dropped first, to change or to make way
-- --------------------------------------------------------------------------

ALTER TABLE public.kept DROP CONSTRAINT kept_c_id_fkey;

ALTER TABLE public.a DROP CONSTRAINT a_b_fkey;

ALTER TABLE public.b DROP CONSTRAINT b_a_id_fkey;

ALTER TABLE public.c DROP CONSTRAINT c_a_id_fkey;

-- --------------------------------------------------------------------------
-- Tables and columns
-- --------------------------------------------------------------------------

-- Possibly a rename of customers: the RENAME keeps its rows, where this
-- CREATE and the DROP below lose them.
-- To keep the data instead:
--   ALTER TABLE public.customers RENAME TO clients;
CREATE TABLE public.clients (
    id integer NOT NULL,
    name text NOT NULL,
    CONSTRAINT clients_pkey PRIMARY KEY (id)
);

-- --------------------------------------------------------------------------
-- Removals. DESTRUCTIVE: what follows deletes data. Back up first.
-- --------------------------------------------------------------------------

-- DESTRUCTIVE: Deletes the table and its rows.
DROP TABLE public.a;

-- DESTRUCTIVE: Deletes the table and its rows.
DROP TABLE public.b;

-- DESTRUCTIVE: Deletes the table and its rows.
DROP TABLE public.c;

-- DESTRUCTIVE: Deletes the table and its rows. Possibly renamed to clients:
-- see the CREATE TABLE above.
-- To keep the data instead:
--   ALTER TABLE public.customers RENAME TO clients;
DROP TABLE public.customers;

COMMIT;

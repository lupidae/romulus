-- Migration of acme/app from v1 to v2, generated by romulus on 2026-10-16.
-- Review it before applying: romulus compares the schemas, not your data.
-- 13 statements, 2 destructive (marked DESTRUCTIVE: they delete data or can
-- fail on existing rows).
--
-- Warnings:
--   - public.events changes from a table to a table partitioned by RANGE
--     (at): it is dropped and created again, losing its rows.
--   - public.totals changes from a table to a view: it is dropped and created
--     again, losing its rows.

BEGIN;

-- --------------------------------------------------------------------------
-- Dropped first, to change or to make way
-- --------------------------------------------------------------------------

DROP VIEW public.recent_events;

-- Created again below: it changed, or something under it did.
DROP VIEW public.note_count;

-- Created again below: it changed, or something under it did.
DROP MATERIALIZED VIEW public.event_days;

-- DESTRUCTIVE: Postgres cannot turn a table into a table partitioned by RANGE
-- (at) in place: it is dropped and created again, empty. Copy its rows out
-- first.
DROP TABLE public.events;

-- DESTRUCTIVE: public.totals becomes a view: the table and its rows go.
DROP TABLE public.totals;

-- --------------------------------------------------------------------------
-- Tables and columns
-- --------------------------------------------------------------------------

CREATE TABLE public.events (
    id bigint NOT NULL,
    at timestamp with time zone NOT NULL,
    CONSTRAINT events_pkey PRIMARY KEY (id, at)
) PARTITION BY RANGE (at);

CREATE TABLE public.events_2026 PARTITION OF public.events FOR VALUES FROM ('2026-01-01 00:00:00+00') TO ('2027-01-01 00:00:00+00');

-- --------------------------------------------------------------------------
-- Views
-- --------------------------------------------------------------------------

-- Runs its query to fill it. On large tables, add WITH NO DATA and REFRESH it
-- later.
CREATE MATERIALIZED VIEW public.event_days AS
SELECT date_trunc('day'::text, at) AS day,
    count(*) AS n
   FROM public.events
  GROUP BY (date_trunc('day'::text, at));

CREATE UNIQUE INDEX event_days_day ON public.event_days USING btree (day);

CREATE INDEX event_days_n ON public.event_days USING btree (n);

CREATE VIEW public.note_count AS
SELECT count(*) AS n,
    max(id) AS last
   FROM public.notes;

-- Runs its query to fill it. On large tables, add WITH NO DATA and REFRESH it
-- later.
CREATE MATERIALIZED VIEW public.recent_events AS
SELECT id,
    at
   FROM public.events;

CREATE VIEW public.totals AS
SELECT 1 AS n;

COMMIT;

-- Migration of acme/app from v1 to v2, generated by romulus on 2026-10-16.
-- Review it before applying: romulus compares the schemas, not your data.
-- 4 statements, none flagged.
--
-- Warnings:
--   - `public.logs_2025` stops being a partition: the model has no names for
--     its copies of `public.logs`'s keys and indexes, so the migration
--     assumes the ones Postgres gives (`logs_2025_pkey`, `logs_2025_at_idx1`,
--     `logs_2025_line_idx`). Compare with `\d public.logs_2025` on your
--     database: a copy named otherwise is left as it is.

BEGIN;

-- --------------------------------------------------------------------------
-- Dropped first, to change or to make way
-- --------------------------------------------------------------------------

-- Kept, rows and all, as a table of its own.
ALTER TABLE public.logs DETACH PARTITION public.logs_2025;

-- Named as Postgres names a partition's copy of its parent's key or index: if
-- yours has another name (`\d` the table), drop that one instead.
DROP INDEX IF EXISTS public.logs_2025_at_idx1;

-- --------------------------------------------------------------------------
-- Constraints and indexes
-- --------------------------------------------------------------------------

-- IF NOT EXISTS: a partition's copy of its parent's index may have this name
-- already (a table attached keeps its own index as its copy).
CREATE INDEX IF NOT EXISTS logs_2025_by_day ON public.logs_2025 USING btree (at);

-- The partition's copy of its parent's index, which a parent's index made ON
-- ONLY lacks. Named as Postgres names it: under another name (`\d` the
-- table), that copy is enough and this one a duplicate.
CREATE INDEX IF NOT EXISTS logs_2025_line_idx ON public.logs_2025 USING btree (line);

COMMIT;

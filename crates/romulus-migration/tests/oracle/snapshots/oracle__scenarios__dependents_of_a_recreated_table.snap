-- Migration of acme/app from v1 to v2, generated by romulus on 2026-10-16.
-- Review it before applying: romulus compares the schemas, not your data.
-- 9 statements: 1 deletes data (DESTRUCTIVE), each marked.
--
-- Warnings:
--   - public.events changes from a table to a table partitioned by RANGE
--     (at): it is dropped and created again, losing its rows.

BEGIN;

-- --------------------------------------------------------------------------
-- Dropped first, to change or to make way
-- --------------------------------------------------------------------------

DROP POLICY with_event ON public.notes;

-- Created again below: it changed, or something under it did.
DROP VIEW public.recent_events;

ALTER TABLE public.notes DROP CONSTRAINT notes_event_id_event_at_fkey;

-- DESTRUCTIVE: Postgres cannot turn a table into a table partitioned by RANGE
-- (at) in place: it is dropped and created again, empty. Copy its rows out
-- first.
DROP TABLE public.events;

-- --------------------------------------------------------------------------
-- Tables and columns
-- --------------------------------------------------------------------------

CREATE TABLE public.events (
    id integer NOT NULL,
    at date NOT NULL,
    CONSTRAINT events_pkey PRIMARY KEY (id, at)
) PARTITION BY RANGE (at);

CREATE TABLE public.events_2026 PARTITION OF public.events FOR VALUES FROM ('2026-01-01') TO ('2027-01-01');

-- --------------------------------------------------------------------------
-- Constraints and indexes
-- --------------------------------------------------------------------------

-- Dropped above and added back: public.events is created again.
ALTER TABLE public.notes ADD CONSTRAINT notes_event_id_event_at_fkey FOREIGN KEY (event_id, event_at) REFERENCES public.events(id, at);

-- --------------------------------------------------------------------------
-- Views
-- --------------------------------------------------------------------------

CREATE VIEW public.recent_events AS
SELECT id,
    at
   FROM public.events
  WHERE at > '2026-01-01'::date;

-- --------------------------------------------------------------------------
-- Row level security
-- --------------------------------------------------------------------------

-- Dropped above and created again around a change it names.
CREATE POLICY with_event ON public.notes FOR ALL USING (EXISTS ( SELECT 1
   FROM public.events e
  WHERE (e.id = notes.event_id)));

COMMIT;

-- Migration of acme/app from v1 to v2, generated by romulus on 2026-10-16.
-- Review it before applying: romulus compares the schemas, not your data.
-- 6 statements: 1 deletes data (DESTRUCTIVE), each marked.
--
-- Warnings:
--   - public.contacts.note looks renamed to first_remark or second_remark:
--     equally alike, so neither is chosen and the column is dropped and
--     added, its data lost. Turn the right one on to keep its data.
--   - Functions and triggers are not in romulus's model, and Postgres does
--     not rewrite their bodies: check any that use public.contacts.a → b
--     (renamed), public.contacts.b → a (renamed).

BEGIN;

-- --------------------------------------------------------------------------
-- Renames
-- --------------------------------------------------------------------------

-- Through a temporary name: two objects swap names.
ALTER TABLE public.contacts RENAME COLUMN a TO a_romulus_1;

-- A known rename. Keeps the column and its data.
ALTER TABLE public.contacts RENAME COLUMN b TO a;

-- Through a temporary name: two objects swap names.
ALTER TABLE public.contacts RENAME COLUMN a_romulus_1 TO b;

-- --------------------------------------------------------------------------
-- Tables and columns
-- --------------------------------------------------------------------------

-- Possibly a rename of note (off): a RENAME keeps its data.
-- To keep the data instead:
--   ALTER TABLE public.contacts RENAME COLUMN note TO first_remark;
ALTER TABLE public.contacts ADD COLUMN first_remark text;

-- Possibly a rename of note (off): a RENAME keeps its data.
-- To keep the data instead:
--   ALTER TABLE public.contacts RENAME COLUMN note TO second_remark;
ALTER TABLE public.contacts ADD COLUMN second_remark text;

-- --------------------------------------------------------------------------
-- Removals. DESTRUCTIVE: what follows deletes data. Back up first.
-- --------------------------------------------------------------------------

-- DESTRUCTIVE: Deletes the column and its data. Possibly renamed to
-- first_remark or second_remark (off): a RENAME keeps its data.
-- To keep the data instead:
--   ALTER TABLE public.contacts RENAME COLUMN note TO first_remark;
--   ALTER TABLE public.contacts RENAME COLUMN note TO second_remark;
ALTER TABLE public.contacts DROP COLUMN note;

COMMIT;

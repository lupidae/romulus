-- Migration of acme/app from v1 to v2, generated by romulus on 2026-10-16.
-- Review it before applying: romulus compares the schemas, not your data.
-- 3 statements, none flagged.
--
-- Warnings:
--   - Functions and triggers are not in romulus's model, and Postgres does
--     not rewrite their bodies: check any that use public.users.email (now
--     ext.citext).

BEGIN;

-- --------------------------------------------------------------------------
-- Schemas and extensions
-- --------------------------------------------------------------------------

CREATE SCHEMA IF NOT EXISTS ext;

ALTER EXTENSION citext SET SCHEMA ext;

-- --------------------------------------------------------------------------
-- Tables and columns
-- --------------------------------------------------------------------------

ALTER TABLE public.users ALTER COLUMN email TYPE ext.citext;

COMMIT;

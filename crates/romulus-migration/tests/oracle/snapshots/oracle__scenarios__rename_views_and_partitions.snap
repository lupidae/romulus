-- Migration of acme/app from v1 to v2, generated by romulus on 2026-10-16.
-- Review it before applying: romulus compares the schemas, not your data.
-- 3 statements, none flagged.
--
-- Warnings:
--   - Functions and triggers are not in romulus's model, and Postgres does
--     not rewrite their bodies: check any that use public.events_y2026 →
--     events_2026 (renamed), public.event_stats → event_totals (renamed),
--     public.event_days → days_with_events (renamed).

BEGIN;

-- --------------------------------------------------------------------------
-- Renames
-- --------------------------------------------------------------------------

-- Detected as a rename (same parent and bound; similar name): turn it off to
-- drop and add instead. Keeps the table, its rows, and everything on it or
-- referencing it.
ALTER TABLE public.events_y2026 RENAME TO events_2026;

-- Detected as a rename (same query; similar name): turn it off to drop and
-- add instead. What reads it keeps reading it.
ALTER MATERIALIZED VIEW public.event_stats RENAME TO event_totals;

-- Detected as a rename (same query): turn it off to drop and add instead.
-- What reads it keeps reading it.
ALTER VIEW public.event_days RENAME TO days_with_events;

COMMIT;

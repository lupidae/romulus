-- Migration of acme/app from v1 to v2, generated by romulus on 2026-10-16.
-- Review it before applying: romulus compares the schemas, not your data.
-- 11 statements, 2 destructive (marked DESTRUCTIVE: they delete data or can
-- fail on existing rows).

BEGIN;

-- --------------------------------------------------------------------------
-- Tables and columns
-- --------------------------------------------------------------------------

-- Attached again below with its new bound.
ALTER TABLE public.logs DETACH PARTITION public.logs_2025;

-- Attached again below with its new bound.
ALTER TABLE public.sales DETACH PARTITION public.sales_eu;

-- Attached again below with its new bound.
ALTER TABLE public.sales DETACH PARTITION public.sales_us;

-- DESTRUCTIVE: Deletes the partition and its rows.
DROP TABLE public.logs_2026h1;

-- DESTRUCTIVE: Deletes the partition and its rows.
DROP TABLE public.logs_2026h2;

-- Fails if the DEFAULT partition holds rows that belong here: move them out
-- first.
CREATE TABLE public.logs_2026 PARTITION OF public.logs FOR VALUES FROM ('2026-02-01') TO ('2027-01-01') PARTITION BY LIST (region);

CREATE TABLE public.logs_2026_eu PARTITION OF public.logs_2026 FOR VALUES IN ('eu');

CREATE TABLE public.logs_2026_rest PARTITION OF public.logs_2026 DEFAULT;

-- Scans the partition to check every row fits the bound.
ALTER TABLE public.logs ATTACH PARTITION public.logs_2025 FOR VALUES FROM ('2025-01-01') TO ('2026-02-01');

-- Scans the partition to check every row fits the bound.
ALTER TABLE public.sales ATTACH PARTITION public.sales_eu FOR VALUES IN ('fr', 'de', 'it');

-- Scans the partition to check every row fits the bound.
ALTER TABLE public.other_sales ATTACH PARTITION public.sales_us FOR VALUES IN ('us');

COMMIT;

-- Migration of acme/app from v1 to v2, generated by romulus on 2026-10-16.
-- Review it before applying: romulus compares the schemas, not your data.
-- 6 statements, none flagged.
--
-- Warnings:
--   - Functions and triggers are not in romulus's model, and Postgres does
--     not rewrite their bodies: check any that use public.mood → archive.mood
--     (moved), public.customers → archive.customers (moved), public.notes →
--     archive.old_notes (moved), public.audit_log → archive.audit_log
--     (moved).

BEGIN;

-- --------------------------------------------------------------------------
-- Schemas and extensions
-- --------------------------------------------------------------------------

CREATE SCHEMA IF NOT EXISTS archive;

-- --------------------------------------------------------------------------
-- Renames
-- --------------------------------------------------------------------------

-- A known move. Its columns keep their values.
ALTER TYPE public.mood SET SCHEMA archive;

-- A known move. Keeps the table, its rows, and everything on it or
-- referencing it.
ALTER TABLE public.customers SET SCHEMA archive;

-- A known move. Keeps the table, its rows, and everything on it or
-- referencing it.
ALTER TABLE public.notes SET SCHEMA archive;

-- A known move. Keeps the table, its rows, and everything on it or
-- referencing it.
ALTER TABLE archive.notes RENAME TO old_notes;

-- Detected as a move (same columns, keys and indexes; the same name, in
-- another schema): turn it off to drop and add instead. Keeps the table, its
-- rows, and everything on it or referencing it.
ALTER TABLE public.audit_log SET SCHEMA archive;

COMMIT;

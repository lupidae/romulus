-- Migration of acme/app from v1 to v2, generated by romulus on 2026-10-16.
-- Review it before applying: romulus compares the schemas, not your data.
-- 12 statements: 1 deletes data (DESTRUCTIVE), 1 can fail on existing rows
-- (CAN FAIL), each marked.
--
-- Warnings:
--   - public.t: Postgres adds columns last, so they end up as (id, a, b, c,
--     d, e, f, h, g). Only SELECT * and INSERT without a column list notice.

BEGIN;

-- --------------------------------------------------------------------------
-- Tables and columns
-- --------------------------------------------------------------------------

-- Keeps the values computed so far; new rows get the default instead.
ALTER TABLE public.t ALTER COLUMN f DROP EXPRESSION;

-- Drops the identity's sequence too.
ALTER TABLE public.t ALTER COLUMN h DROP IDENTITY;

-- DESTRUCTIVE: It becomes generated, which Postgres cannot do in place:
-- dropped and added again, its values replaced by the generated ones.
ALTER TABLE public.t DROP COLUMN g;

ALTER TABLE public.t ALTER COLUMN a SET DEFAULT 0;

-- CAN FAIL: Fails if a row holds NULL here: fill those first.
ALTER TABLE public.t ALTER COLUMN a SET NOT NULL;

ALTER TABLE public.t ALTER COLUMN b DROP DEFAULT;

ALTER TABLE public.t ALTER COLUMN b DROP NOT NULL;

ALTER TABLE public.t ALTER COLUMN c SET GENERATED BY DEFAULT;

ALTER TABLE public.t ALTER COLUMN d ADD GENERATED ALWAYS AS IDENTITY;

-- The identity's sequence starts at 1: moved past the values the column
-- already holds.
SELECT setval(pg_get_serial_sequence('public.t', 'd'), coalesce(max(d), 0) + 1, false) FROM public.t;

-- PostgreSQL 17 or later; it rewrites the table (stored column).
ALTER TABLE public.t ALTER COLUMN e SET EXPRESSION AS ((a * 3));

ALTER TABLE public.t ADD COLUMN g integer GENERATED ALWAYS AS ((a - 1)) STORED;

COMMIT;

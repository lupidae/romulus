-- Migration of acme/app from v1 to v2, generated by romulus on 2026-10-16.
-- Review it before applying: romulus compares the schemas, not your data.
-- 2 statements, none flagged.
--
-- Warnings:
--   - Functions and triggers are not in romulus's model, and Postgres does
--     not rewrite their bodies: check any that use public.accounts.code →
--     account_code (renamed), public.accounts.account_code (now character
--     varying(64)).

BEGIN;

-- --------------------------------------------------------------------------
-- Renames
-- --------------------------------------------------------------------------

-- Detected as a rename (compatible type; same place; similar name): turn it
-- off to drop and add instead. Keeps the column and its data.
ALTER TABLE public.accounts RENAME COLUMN code TO account_code;

-- --------------------------------------------------------------------------
-- Tables and columns
-- --------------------------------------------------------------------------

ALTER TABLE public.accounts
    ALTER COLUMN account_code DROP DEFAULT,
    ALTER COLUMN account_code TYPE character varying(64),
    ALTER COLUMN account_code SET DEFAULT 'unknown'::character varying;

COMMIT;

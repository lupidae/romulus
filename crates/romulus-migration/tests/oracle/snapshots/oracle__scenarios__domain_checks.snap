-- Migration of acme/app from v1 to v2, generated by romulus on 2026-10-16.
-- Review it before applying: romulus compares the schemas, not your data.
-- 6 statements, none flagged.
--
-- Warnings:
--   - Domain public.email is created again over public.citext, and its
--     columns converted.
--   - Domain public.tag is created again over text, and its columns
--     converted.

BEGIN;

-- --------------------------------------------------------------------------
-- Types
-- --------------------------------------------------------------------------

-- A check goes, and dropping one needs its name, which the schema does not
-- record: the domain is created again and every column using it converted.
ALTER DOMAIN public.email RENAME TO email_old;

CREATE DOMAIN public.email AS public.citext CHECK ((VALUE OPERATOR(public.~) '^[^@]+@[^@]+$'::public.citext));

-- A check goes, and dropping one needs its name, which the schema does not
-- record: the domain is created again and every column using it converted.
ALTER DOMAIN public.tag RENAME TO tag_old;

CREATE DOMAIN public.tag AS text CHECK ((VALUE <> ''::text)) CHECK ((VALUE = lower(VALUE))) CHECK ((length(VALUE) < 80));

-- --------------------------------------------------------------------------
-- Removals
-- --------------------------------------------------------------------------

DROP DOMAIN public.email_old;

DROP DOMAIN public.tag_old;

COMMIT;

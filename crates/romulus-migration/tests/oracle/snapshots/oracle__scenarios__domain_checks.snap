---
source: crates/romulus-migration/tests/oracle/scenarios.rs
expression: "plain[0].content"
---
-- Migration of acme/app from v1 to v2, generated by romulus on 2026-10-16.
-- Review it before applying: romulus compares the schemas, not your data.
-- 3 statements, none destructive.
--
-- Warnings:
--   - Domain public.email drops a check by a guessed name (email_check1): the
--     model does not record domain check names. Check yours with \dD+
--     public.email.
--   - Domain public.tag drops a check by a guessed name (tag_check1): the
--     model does not record domain check names. Check yours with \dD+
--     public.tag.

BEGIN;

-- --------------------------------------------------------------------------
-- Types
-- --------------------------------------------------------------------------

-- Drops CHECK ((VALUE IS NOT NULL)), by the name Postgres gives an unnamed
-- check: if yours has another name, use it.
ALTER DOMAIN public.email DROP CONSTRAINT email_check1;

-- Drops CHECK ((length(VALUE) < 40)), by the name Postgres gives an unnamed
-- check: if yours has another name, use it.
ALTER DOMAIN public.tag DROP CONSTRAINT tag_check1;

-- Fails if a value of this domain already breaks it.
ALTER DOMAIN public.tag ADD CHECK ((length(VALUE) < 80));

COMMIT;

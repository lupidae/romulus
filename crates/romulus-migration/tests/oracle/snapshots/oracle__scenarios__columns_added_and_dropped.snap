-- Migration of acme/app from v1 to v2, generated by romulus on 2026-10-16.
-- Review it before applying: romulus compares the schemas, not your data.
-- 11 statements: 2 delete data (DESTRUCTIVE), 2 can fail on existing rows
-- (CAN FAIL), each marked.
--
-- Warnings:
--   - users.legacy is dropped and users.nickname added, alike: if it is a
--     rename, the RENAME COLUMN in the comment keeps the data.
--   - users.name is dropped and users.full_name added, alike: if it is a
--     rename, the RENAME COLUMN in the comment keeps the data.
--   - public.users: Postgres adds columns last, so they end up as (id, email,
--     nickname, full_name, active, score, seq, num, email_lower). Only SELECT
--     * and INSERT without a column list notice.

BEGIN;

-- --------------------------------------------------------------------------
-- Tables and columns
-- --------------------------------------------------------------------------

-- Possibly a rename of legacy: the RENAME keeps its data, where this ADD and
-- the DROP below lose it.
-- To keep the data instead:
--   ALTER TABLE public.users RENAME COLUMN legacy TO nickname;
ALTER TABLE public.users ADD COLUMN nickname text;

-- CAN FAIL: Possibly a rename of name: the RENAME keeps its data, where this
-- ADD and the DROP below lose it. As it is, this ADD fails if the table has
-- rows (NOT NULL without a default).
-- To keep the data instead:
--   ALTER TABLE public.users RENAME COLUMN name TO full_name;
ALTER TABLE public.users ADD COLUMN full_name text NOT NULL;

ALTER TABLE public.users ADD COLUMN active boolean DEFAULT true NOT NULL;

-- CAN FAIL: Fails if the table has rows: give it a DEFAULT, or add it
-- nullable, fill it, then SET NOT NULL.
ALTER TABLE public.users ADD COLUMN score integer NOT NULL;

CREATE SEQUENCE IF NOT EXISTS public.users_seq_seq;

ALTER TABLE public.users ADD COLUMN seq integer DEFAULT nextval('public.users_seq_seq'::regclass) NOT NULL;

ALTER SEQUENCE public.users_seq_seq OWNED BY public.users.seq;

ALTER TABLE public.users ADD COLUMN num bigint GENERATED BY DEFAULT AS IDENTITY NOT NULL;

ALTER TABLE public.users ADD COLUMN email_lower text GENERATED ALWAYS AS (lower(email)) STORED;

-- --------------------------------------------------------------------------
-- Removals. DESTRUCTIVE: what follows deletes data. Back up first.
-- --------------------------------------------------------------------------

-- DESTRUCTIVE: Deletes the column and its data. Possibly renamed to
-- full_name: see the ADD COLUMN above.
-- To keep the data instead:
--   ALTER TABLE public.users RENAME COLUMN name TO full_name;
ALTER TABLE public.users DROP COLUMN name;

-- DESTRUCTIVE: Deletes the column and its data. Possibly renamed to nickname:
-- see the ADD COLUMN above.
-- To keep the data instead:
--   ALTER TABLE public.users RENAME COLUMN legacy TO nickname;
ALTER TABLE public.users DROP COLUMN legacy;

COMMIT;

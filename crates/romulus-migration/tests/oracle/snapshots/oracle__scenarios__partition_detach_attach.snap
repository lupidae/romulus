-- Migration of acme/app from v1 to v2, generated by romulus on 2026-10-16.
-- Review it before applying: romulus compares the schemas, not your data.
-- 6 statements: 1 deletes data (DESTRUCTIVE), 2 can fail on existing rows
-- (CAN FAIL), each marked.

BEGIN;

-- --------------------------------------------------------------------------
-- Dropped first, to change or to make way
-- --------------------------------------------------------------------------

-- Kept, rows and all, as a table of its own.
ALTER TABLE public.logs DETACH PARTITION public.logs_2025;

-- --------------------------------------------------------------------------
-- Tables and columns
-- --------------------------------------------------------------------------

-- CAN FAIL: Fails if an existing row breaks it. On a large table, add it NOT
-- VALID, then VALIDATE CONSTRAINT.
ALTER TABLE public.logs_2024 ADD CONSTRAINT logs_line_check CHECK ((length(line) < 1000));

-- DESTRUCTIVE: Deletes the column and its data.
ALTER TABLE public.logs_2024 DROP COLUMN source;

ALTER TABLE public.logs_2025 ADD COLUMN reviewed boolean DEFAULT false NOT NULL;

-- CAN FAIL: Attached with its rows: fails if one does not fit the bound (or a
-- DEFAULT partition holds rows that belong here). Its columns were aligned
-- with the parent's above.
ALTER TABLE public.logs ATTACH PARTITION public.logs_2024 FOR VALUES FROM ('2024-01-01') TO ('2025-01-01');

-- --------------------------------------------------------------------------
-- Constraints and indexes
-- --------------------------------------------------------------------------

-- The partition's copy of its parent's index, unless the parent's was made ON
-- ONLY.
CREATE INDEX IF NOT EXISTS logs_2025_at_idx ON public.logs_2025 USING btree (at);

COMMIT;

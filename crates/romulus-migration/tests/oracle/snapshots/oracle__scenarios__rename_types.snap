-- Migration of acme/app from v1 to v2, generated by romulus on 2026-10-16.
-- Review it before applying: romulus compares the schemas, not your data.
-- 4 statements, none flagged.
--
-- Warnings:
--   - Functions and triggers are not in romulus's model, and Postgres does
--     not rewrite their bodies: check any that use public.mood → feeling
--     (renamed), public.email → email_address (renamed), public.point2 →
--     location (renamed), public.feeling.ok → fine (renamed).

BEGIN;

-- --------------------------------------------------------------------------
-- Renames
-- --------------------------------------------------------------------------

-- Detected as a rename (same labels but one, in place; its columns switch to
-- it): turn it off to drop and add instead. Its columns keep their values.
ALTER TYPE public.mood RENAME TO feeling;

-- Detected as a rename (same base type, default and checks; its columns
-- switch to it; similar name): turn it off to drop and add instead. Its
-- columns keep their values.
ALTER DOMAIN public.email RENAME TO email_address;

-- Detected as a rename (same attributes; its columns switch to it): turn it
-- off to drop and add instead. Its columns keep their values.
ALTER TYPE public.point2 RENAME TO location;

-- Detected as a rename (same place among the labels): turn it off to drop and
-- add instead. Rows holding the label read the new one.
ALTER TYPE public.feeling RENAME VALUE 'ok' TO 'fine';

COMMIT;

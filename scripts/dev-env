#!/usr/bin/env bash
# Writes .env for this worktree: a port slot, the compose project name, and
# every URL derived from them. Several worktrees of this repo run their own
# stacks at the same time, so nothing here may be a fixed port.
#
# The slot is the only input. It comes from, in order: $ROMULUS_SLOT, the slot
# already in .env, the slot this worktree holds in the registry, or the lowest
# free one. The registry lives in the git common dir, so every worktree of one
# clone sees it and nothing is committed.
#
#   slot N  →  ports 41000 + 10·N … +9   (see the table in CLAUDE.md)
#
#   scripts/dev-env            write .env (idempotent)
#   scripts/dev-env --release  give this worktree's slot back (teardown)
set -euo pipefail

root=$(git rev-parse --show-toplevel)
cd "$root"

registry="$(git rev-parse --path-format=absolute --git-common-dir)/romulus-slots"
lock="$registry.lock"
max_slot=99

port_base() { echo $((41000 + 10 * $1)); }

slot_ports_free() {
    local base
    base=$(port_base "$1")
    for offset in 0 1 2 3 4 5; do
        if nc -z 127.0.0.1 $((base + offset)) 2>/dev/null; then
            return 1
        fi
    done
}

acquire_lock() {
    local tries=0
    until mkdir "$lock" 2>/dev/null; do
        tries=$((tries + 1))
        if [ "$tries" -gt 50 ]; then
            echo "dev-env: $lock is held; remove it if no other dev-env is running" >&2
            exit 1
        fi
        sleep 0.1
    done
    trap 'rmdir "$lock" 2>/dev/null || true' EXIT
}

if [ "${1:-}" = --release ]; then
    acquire_lock
    touch "$registry"
    awk -v p="$root" '$2 != p' "$registry" > "$registry.tmp" && mv "$registry.tmp" "$registry"
    echo "dev-env: released the slot of $root"
    exit 0
fi

slot="${ROMULUS_SLOT:-}"
if [ -z "$slot" ] && [ -f .env ]; then
    slot=$(sed -n 's/^ROMULUS_SLOT=//p' .env | head -1)
fi

acquire_lock
touch "$registry"
# Forget worktrees that no longer exist, so their slots come back.
tmp=$(mktemp)
while IFS=' ' read -r s path; do
    [ -n "$path" ] && [ -d "$path" ] && [ "$path" != "$root" ] && echo "$s $path"
done < "$registry" > "$tmp" || true
if [ -z "$slot" ]; then
    slot=$(awk -v p="$root" '$2 == p { print $1 }' "$registry" | head -1)
fi
if [ -z "$slot" ]; then
    for candidate in $(seq 0 "$max_slot"); do
        if ! awk '{ print $1 }' "$tmp" | grep -qx "$candidate" && slot_ports_free "$candidate"; then
            slot=$candidate
            break
        fi
    done
fi
if [ -z "$slot" ]; then
    echo "dev-env: no free slot in 0..$max_slot" >&2
    exit 1
fi
echo "$slot $root" >> "$tmp"
sort -n "$tmp" > "$registry"
rm -f "$tmp"

base=$(port_base "$slot")
web=$base
api=$((base + 1))
postgres=$((base + 2))
sandbox=$((base + 3))
zitadel=$((base + 4))
preview=$((base + 5))

# Compose project names allow [a-z0-9_-] and must start with a letter or digit.
name=$(basename "$root" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9_\n-' '-')
project="romulus-$name"
[ "$name" = romulus ] && project=romulus

cat > .env <<EOF
# Generated by scripts/dev-env for $root.
# Do not edit by hand: change the slot with \`ROMULUS_SLOT=<n> scripts/dev-env\`.
ROMULUS_SLOT=$slot
COMPOSE_PROJECT_NAME=$project

ROMULUS_WEB_PORT=$web
ROMULUS_API_PORT=$api
ROMULUS_POSTGRES_PORT=$postgres
ROMULUS_SANDBOX_PORT=$sandbox
ROMULUS_ZITADEL_PORT=$zitadel
ROMULUS_PREVIEW_PORT=$preview

# The browser only ever talks to the web origin: the SPA lives under /app and
# Vite proxies /api to the API, as the API itself will serve both in production.
ROMULUS_PUBLIC_URL=http://localhost:$web
ROMULUS_API_ADDR=127.0.0.1:$api
DATABASE_URL=postgres://romulus:romulus@127.0.0.1:$postgres/romulus
ROMULUS_SANDBOX_URL=postgres://sandbox_admin:sandbox_admin@127.0.0.1:$sandbox/postgres
ROMULUS_OIDC_ISSUER=http://localhost:$zitadel
# Cookies are not port-scoped: two stacks on localhost would share one cookie.
ROMULUS_SESSION_COOKIE=romulus_session_$slot
# Dev-only sign-in without Zitadel's UI (QA, Playwright). The API refuses to
# start with it unless ROMULUS_PUBLIC_URL is a loopback address.
ROMULUS_DEV_SIGNIN=true

# Files the Zitadel provisioner writes into .dev/ belong to this user.
ROMULUS_UID=$(id -u)
ROMULUS_GID=$(id -g)
EOF

echo "dev-env: slot $slot, project $project, web http://localhost:$web, api :$api, postgres :$postgres, sandbox :$sandbox, zitadel :$zitadel"

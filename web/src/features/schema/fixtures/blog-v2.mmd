erDiagram
    comments {
        bigint id PK "identity"
        bigint post_id FK
        bigint author_id FK
        bigint parent_id FK "nullable"
        text body
        timestamp_with_time_zone posted_at
    }
    post_reactions {
        bigint post_id PK,FK
        bigint user_id PK,FK
        reaction_kind kind PK "enum"
        timestamp_with_time_zone reacted_at
    }
    post_tags {
        bigint post_id PK,FK
        integer tag_id PK,FK
    }
    posts {
        bigint id PK "identity"
        bigint author_id FK
        text title
        text slug UK "URL fragment, unique per site"
        text body_md "Markdown source; HTML is rendered at read time"
        integer reading_minutes "generated, nullable"
        post_status status "enum"
        timestamp_with_time_zone published_at "nullable"
        timestamp_with_time_zone updated_at
    }
    subscriptions {
        bigint id PK "identity"
        bigint user_id FK,UK
        text plan
        timestamp_with_time_zone renews_at "nullable"
    }
    tags {
        integer id PK "identity"
        text name UK
    }
    users {
        bigint id PK "identity"
        text email UK "Lowercased on write"
        text avatar_url "Absolute URL, served through the image proxy"
        character_varying(120) name
        timestamp_with_time_zone created_at
    }
    users ||--o{ comments : "author_id"
    comments |o--o{ comments : "parent_id"
    posts ||--o{ comments : "post_id"
    posts ||--o{ post_reactions : "post_id"
    users ||--o{ post_reactions : "user_id"
    posts ||--o{ post_tags : "post_id"
    tags ||--o{ post_tags : "tag_id"
    users ||--o{ posts : "author_id"
    users ||--o| subscriptions : "user_id"

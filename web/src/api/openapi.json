{
  "openapi": "3.1.0",
  "info": {
    "title": "romulus",
    "description": "DBA as a service: versioned Postgres schemas, diffs and collaborative drafts.",
    "license": {
      "name": "UNLICENSED",
      "identifier": "UNLICENSED"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/auth/callback": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "The IdP's redirect back: exchanges the code, verifies the ID token,\nupserts the user and starts a session. Requires a verified email.",
        "operationId": "auth_callback",
        "parameters": [
          {
            "name": "code",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "error",
            "in": "query",
            "description": "Set by the IdP instead of `code` when sign-in did not happen.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "303": {
            "description": "Signed in: to the `next` of the sign-in, with the session cookie. Otherwise to `/app/signin?error=…`"
          }
        }
      }
    },
    "/api/auth/login": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Starts signing in: redirects to the IdP's authorization endpoint (code\nflow, PKCE S256, state, nonce).",
        "operationId": "login",
        "parameters": [
          {
            "name": "next",
            "in": "query",
            "description": "Where to land afterwards: a path under `/app`. Anything else is\nignored (the app's home instead).",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "prompt",
            "in": "query",
            "description": "`select_account` asks the IdP which account to use even when one is\nalready signed in there (\"switch account\").",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "login_hint",
            "in": "query",
            "description": "The address to sign in with (an invitation's): the IdP pre-fills it,\nor offers to create the account. Anything not shaped like an email\nis ignored.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "303": {
            "description": "To the IdP; or to `/app/signin?error=sso_unavailable` when it is unreachable"
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Ends the session (idempotent: an expired one is fine) and clears the\ncookie. The web app then navigates to `redirect_url` to end the IdP\nsession too.",
        "operationId": "logout",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignedOut"
                }
              }
            }
          },
          "403": {
            "description": "Missing CSRF header or foreign Origin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/methods": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "What the sign-in page can offer.",
        "operationId": "auth_methods",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthMethods"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness and database reachability, for compose healthchecks and CI.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "The API and its database are up",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "The database is unreachable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/invitations/{token}": {
      "get": {
        "tags": [
          "invitations"
        ],
        "summary": "What an invitation link invites to, and whether the viewer (signed in or\nnot) can accept it. Anyone holding the link may look.",
        "operationId": "preview_invitation",
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "description": "The token from the invitation link",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvitationPreview"
                }
              }
            }
          },
          "404": {
            "description": "Unknown, revoked or replaced link",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/invitations/{token}/accept": {
      "post": {
        "tags": [
          "invitations"
        ],
        "summary": "Joins the organization with the invited role. The caller must be signed\nin with the invited email, verified by the IdP.",
        "operationId": "accept_invitation",
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "description": "The token from the invitation link",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Accepted"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "`wrong_account` or `email_unverified`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "`invitation_expired` or `invitation_used`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "The signed-in user.",
        "operationId": "me",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUser"
                }
              }
            }
          },
          "401": {
            "description": "`unauthorized`, or `session_expired` when the cookie's session is gone",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/orgs": {
      "get": {
        "tags": [
          "orgs"
        ],
        "summary": "The organizations the caller belongs to, by name.",
        "operationId": "list_orgs",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Org"
                  }
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "orgs"
        ],
        "summary": "Creates an organization; the caller becomes its admin.",
        "operationId": "create_org",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOrg"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Org"
                }
              }
            }
          },
          "409": {
            "description": "`slug_taken`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "`validation`, `details` names the field",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/orgs/{org}": {
      "get": {
        "tags": [
          "orgs"
        ],
        "summary": "One organization the caller belongs to.",
        "operationId": "get_org",
        "parameters": [
          {
            "name": "org",
            "in": "path",
            "description": "The organization's slug",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Org"
                }
              }
            }
          },
          "404": {
            "description": "No such organization, or not a member",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "orgs"
        ],
        "summary": "Renames an organization, or moves it to another slug. Admins only.",
        "operationId": "update_org",
        "parameters": [
          {
            "name": "org",
            "in": "path",
            "description": "The organization's slug",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateOrg"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Org"
                }
              }
            }
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "`slug_taken`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/orgs/{org}/invitations": {
      "get": {
        "tags": [
          "invitations"
        ],
        "summary": "Pending invitations, newest first, expired ones included. Admins only.",
        "operationId": "list_invitations",
        "parameters": [
          {
            "name": "org",
            "in": "path",
            "description": "The organization's slug",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Invitation"
                  }
                }
              }
            }
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "invitations"
        ],
        "summary": "Invites an email address with a role and answers the one-time link.\nInviting an address that already has a pending invitation replaces it\n(the old link stops working). Admins only.",
        "operationId": "create_invitation",
        "parameters": [
          {
            "name": "org",
            "in": "path",
            "description": "The organization's slug",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateInvitation"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedInvitation"
                }
              }
            }
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "`already_member`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/orgs/{org}/invitations/{id}": {
      "delete": {
        "tags": [
          "invitations"
        ],
        "summary": "Revokes a pending invitation: its link stops working. Admins only.",
        "operationId": "revoke_invitation",
        "parameters": [
          {
            "name": "org",
            "in": "path",
            "description": "The organization's slug",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "description": "The invitation's id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Revoked"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "No such pending invitation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/orgs/{org}/members": {
      "get": {
        "tags": [
          "orgs"
        ],
        "summary": "Everyone in the organization, by name. Any member may see who else is.",
        "operationId": "list_members",
        "parameters": [
          {
            "name": "org",
            "in": "path",
            "description": "The organization's slug",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OrgMember"
                  }
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/orgs/{org}/members/{user}": {
      "delete": {
        "tags": [
          "orgs"
        ],
        "summary": "Removes a member. Admins may remove anyone; any member may remove\nthemselves (leave). The last admin cannot go (409 `last_admin`). Closes\nthe member's live connections.",
        "operationId": "remove_member",
        "parameters": [
          {
            "name": "org",
            "in": "path",
            "description": "The organization's slug",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "user",
            "in": "path",
            "description": "The member's user id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Removed"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "No such member",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "`last_admin`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "orgs"
        ],
        "summary": "Changes a member's role. Admins only; the last admin cannot be demoted\n(409 `last_admin`). Closes the member's live connections.",
        "operationId": "change_member_role",
        "parameters": [
          {
            "name": "org",
            "in": "path",
            "description": "The organization's slug",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "user",
            "in": "path",
            "description": "The member's user id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangeRole"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrgMember"
                }
              }
            }
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "No such member",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "`last_admin`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Accepted": {
        "type": "object",
        "required": [
          "org",
          "already_member"
        ],
        "properties": {
          "already_member": {
            "type": "boolean",
            "description": "The caller was a member already; nothing changed."
          },
          "org": {
            "$ref": "#/components/schemas/Org"
          }
        }
      },
      "AuthMethods": {
        "type": "object",
        "required": [
          "sso",
          "dev_signin"
        ],
        "properties": {
          "dev_signin": {
            "type": "boolean",
            "description": "The dev-only sign-in exists (`GET /api/auth/dev-signin?email=…`)."
          },
          "sso": {
            "type": "boolean",
            "description": "Single sign-on is configured (Zitadel is provisioned)."
          }
        }
      },
      "ChangeRole": {
        "type": "object",
        "required": [
          "role"
        ],
        "properties": {
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        }
      },
      "CreateInvitation": {
        "type": "object",
        "required": [
          "email",
          "role"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        }
      },
      "CreateOrg": {
        "type": "object",
        "required": [
          "name",
          "slug"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "1 to 100 characters."
          },
          "slug": {
            "type": "string",
            "description": "Lowercase letters, digits and single hyphens, at most 63 characters,\nnot one of the app's own routes."
          }
        }
      },
      "CreatedInvitation": {
        "type": "object",
        "required": [
          "invitation",
          "url"
        ],
        "properties": {
          "invitation": {
            "$ref": "#/components/schemas/Invitation"
          },
          "url": {
            "type": "string",
            "description": "The one-time link to send to the invitee. Shown only now."
          }
        }
      },
      "CurrentUser": {
        "type": "object",
        "description": "The signed-in user, from the session cookie. Every endpoint that needs a\nperson takes it (or [`super::Member`], which includes it).\n\nRejects with 401 `unauthorized` without a cookie, 401 `session_expired`\nwith a cookie whose session is gone, and 401 `unauthorized` for any\nrequest with `Authorization: Bearer`: API tokens are not people, and a\nbearer request never falls back to the cookie (see `crate::csrf`).",
        "required": [
          "id",
          "email",
          "email_verified",
          "name"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "email_verified": {
            "type": "boolean",
            "description": "Accepting an invitation requires it."
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "description": "The body of every error response.\n\n`code` is stable and machine-readable (the web app switches on it);\n`message` is for people and may change.",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "e.g. `not_found`, `validation`, `csrf`, `last_admin`."
          },
          "details": {
            "description": "Structured context, e.g. per-field validation messages."
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "status",
          "database",
          "version"
        ],
        "properties": {
          "database": {
            "type": "string",
            "description": "`ok` when a query round-trips."
          },
          "status": {
            "type": "string",
            "description": "Always `ok` in a 200."
          },
          "version": {
            "type": "string",
            "description": "The API's crate version."
          }
        }
      },
      "Invitation": {
        "type": "object",
        "description": "A pending invitation (its link is never shown again).",
        "required": [
          "id",
          "email",
          "role",
          "created_at",
          "expires_at",
          "expired"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "email": {
            "type": "string"
          },
          "expired": {
            "type": "boolean",
            "description": "The link no longer works; inviting the address again makes a new one."
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "invited_by": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Person",
                "description": "`None` once that admin's account is deleted."
              },
              {
                "type": "null"
              }
            ]
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        }
      },
      "InvitationPreview": {
        "type": "object",
        "description": "What an invitation link invites to, for its landing page.",
        "required": [
          "org",
          "role",
          "expires_at",
          "status"
        ],
        "properties": {
          "email": {
            "type": [
              "string",
              "null"
            ],
            "description": "The invited address: who has to be signed in to accept. Only while\nthe link can still be used; a used or expired link no longer says."
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "invited_by": {
            "type": [
              "string",
              "null"
            ]
          },
          "member_role": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Role",
                "description": "The viewer's role when `status` is `already_member`."
              },
              {
                "type": "null"
              }
            ]
          },
          "org": {
            "$ref": "#/components/schemas/OrgSummary"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "status": {
            "$ref": "#/components/schemas/InvitationStatus"
          }
        }
      },
      "InvitationStatus": {
        "type": "string",
        "description": "Where the viewer of an invitation link stands.",
        "enum": [
          "sign_in_required",
          "ready",
          "wrong_account",
          "email_unverified",
          "already_member",
          "expired",
          "used"
        ]
      },
      "Org": {
        "type": "object",
        "description": "An organization, as one of its members sees it.",
        "required": [
          "id",
          "slug",
          "name",
          "role"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role",
            "description": "The caller's role in it."
          },
          "slug": {
            "type": "string",
            "description": "Its address: `/app/<slug>`."
          }
        }
      },
      "OrgMember": {
        "type": "object",
        "required": [
          "user_id",
          "name",
          "email",
          "role",
          "joined_at"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "joined_at": {
            "type": "string",
            "format": "date-time"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "user_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "OrgSummary": {
        "type": "object",
        "required": [
          "name",
          "slug"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          }
        }
      },
      "Person": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "Role": {
        "type": "string",
        "description": "A member's role in an organization (`member_role`).",
        "enum": [
          "admin",
          "developer",
          "reviewer"
        ]
      },
      "SignedOut": {
        "type": "object",
        "required": [
          "redirect_url"
        ],
        "properties": {
          "redirect_url": {
            "type": "string",
            "description": "Where the browser goes next: the IdP's logout (which comes back to\nthe sign-in page), or the sign-in page itself."
          }
        }
      },
      "UpdateOrg": {
        "type": "object",
        "properties": {
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "slug": {
            "type": [
              "string",
              "null"
            ],
            "description": "Changing it changes every link to the organization."
          }
        }
      }
    }
  }
}
